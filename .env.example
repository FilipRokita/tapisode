# Application configuration. Copy to .env and fill in the values.
# Locally only the first four are required. A host needs the whole file.

# --- Required locally -------------------------------------------------------

# Local database. The dev container creates it (see .devcontainer/db-setup.sh).
DATABASE_URL=postgresql://tapisode:tapisode@localhost:5432/tapisode

# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# TMDB "API Read Access Token" (the long bearer token, not the short API key).
# Create it in your TMDB account under Settings, API.
TMDB_API_READ_ACCESS_TOKEN=

# --- Optional locally -------------------------------------------------------

# Catalog provider: "tmdb" (default) or "fake" (invented data, no token needed).
MEDIA_PROVIDER=tmdb

# --- Needed on a host -------------------------------------------------------

# Direct (unpooled) connection string, used only by migrations. The Neon and
# Vercel integration sets it. Leave unset locally and it falls back to
# DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Protects the cron route. Vercel sends it as a bearer token.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Encryption key for Server Action ids. Required once more than one instance
# serves traffic. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
