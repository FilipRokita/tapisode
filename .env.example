# Application configuration. Copy to .env and fill in the values.
#
# Locally only the first four are required, and the rest can stay as they are.
# On a host (Vercel) set the same names in the project's environment variables.
# Each variable notes what changes there.

# --- Required locally -------------------------------------------------------

# Database connection string.
# Local: the dev container creates the database (.devcontainer/db-setup.sh).
# On a host: the pooled Neon connection string. The Neon and Vercel integration
# sets it for you.
DATABASE_URL=postgresql://tapisode:tapisode@localhost:5432/tapisode

# Signs sessions. Generate with: openssl rand -base64 32
# On a host: use a different value than locally.
BETTER_AUTH_SECRET=

# The public URL of the app.
# On a host: the production URL, for example https://tapisode.example.com
BETTER_AUTH_URL=http://localhost:3000

# TMDB "API Read Access Token" (the long bearer token, not the short API key).
# Create it in your TMDB account under Settings, API.
# On a host: the same token.
TMDB_API_READ_ACCESS_TOKEN=

# --- Optional locally -------------------------------------------------------

# Catalog provider: "tmdb" (default) or "fake" (invented data, no token needed).
MEDIA_PROVIDER=tmdb

# --- Only on a host ---------------------------------------------------------

# Direct (unpooled) connection string, used only by migrations.
# The Neon and Vercel integration sets it for you.
# Local: leave it empty and migrations use DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Protects the cron route. Vercel sends it as a bearer token.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Encrypts Server Action ids when more than one instance serves traffic.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
