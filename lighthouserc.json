{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3211",
      "url": ["http://localhost:3211/", "http://localhost:3211/signin", "http://localhost:3211/privacy"],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3211/(privacy)?$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3211/signin$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        }
      ]
    }
  }
}
